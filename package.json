{
  "name": "mark-hider",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "build": "esbuild src/main.ts --bundle --external:obsidian --external:@codemirror/state --external:@codemirror/view --format=cjs --platform=browser --target=es2020 --outfile=dist/main.js && cp styles.css dist/",
    "deploy": "npm run build && cp dist/main.js dist/styles.css manifest.json \"${OBSIDIAN_PLUGIN_DIR:-../../.obsidian/plugins/mark-hider}/\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.36.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  }
}